generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model addresses {
  id             BigInt          @id @default(autoincrement())
  user_id        BigInt
  label          String?         @db.VarChar(40)
  recipient_name String          @db.VarChar(150)
  phone          String          @db.VarChar(20)
  province       String          @db.VarChar(100)
  district       String          @db.VarChar(100)
  ward           String          @db.VarChar(100)
  street         String          @db.VarChar(255)
  note           String?
  latitude       Decimal?        @db.Decimal(9, 6)
  longitude      Decimal?        @db.Decimal(9, 6)
  is_default     Boolean         @default(false)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @db.Timestamptz(6)
  users          users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders         orders[]
  subscriptions  subscriptions[]

  @@index([user_id], map: "idx_addresses_user")
}

model allergens {
  id                  BigInt                @id @default(autoincrement())
  code                String                @unique @db.VarChar(40)
  name_vi             String                @db.VarChar(100)
  name_en             String?               @db.VarChar(100)
  description         String?
  icon_url            String?
  product_allergens   product_allergens[]
  quiz_option_effects quiz_option_effects[]
  user_allergens      user_allergens[]
}

model audit_logs {
  id          BigInt   @id @default(autoincrement())
  user_id     BigInt?
  action      String   @db.VarChar(10)
  entity_type String   @db.VarChar(60)
  entity_id   BigInt?
  old_data    Json?
  new_data    Json?
  ip_address  String?  @db.Inet
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([entity_type, entity_id], map: "idx_audit_entity")
  @@index([user_id, created_at(sort: Desc)], map: "idx_audit_user")
}

model badges {
  id            BigInt        @id @default(autoincrement())
  code          String        @unique @db.VarChar(40)
  name          String        @db.VarChar(120)
  description   String?
  icon_url      String?
  points_reward Int           @default(0)
  challenges    challenges[]
  user_badges   user_badges[]
}

model banners {
  id         BigInt    @id @default(autoincrement())
  title      String?   @db.VarChar(200)
  image_url  String
  link_url   String?
  position   String    @default("home_hero") @db.VarChar(40)
  sort_order Int       @default(0)
  starts_at  DateTime? @db.Timestamptz(6)
  ends_at    DateTime? @db.Timestamptz(6)
  is_active  Boolean   @default(true)
}

model blog_categories {
  id         BigInt       @id @default(autoincrement())
  name       String       @db.VarChar(120)
  slug       String       @unique @db.VarChar(150)
  blog_posts blog_posts[]
}

model blog_comments {
  id                  BigInt          @id @default(autoincrement())
  post_id             BigInt
  user_id             BigInt
  parent_id           BigInt?
  content             String
  status              review_status   @default(approved)
  created_at          DateTime        @default(now()) @db.Timestamptz(6)
  blog_comments       blog_comments?  @relation("blog_commentsToblog_comments", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_blog_comments blog_comments[] @relation("blog_commentsToblog_comments")
  blog_posts          blog_posts      @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users               users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([post_id], map: "idx_blog_comments_post")
}

model blog_post_tags {
  post_id    BigInt
  tag_id     BigInt
  blog_posts blog_posts @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tags       tags       @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([post_id, tag_id])
}

model blog_posts {
  id               BigInt                   @id @default(autoincrement())
  category_id      BigInt?
  author_id        BigInt?
  title            String                   @db.VarChar(300)
  slug             String                   @unique @db.VarChar(330)
  summary          String?
  content          String
  cover_image_url  String?
  expert_reviewer  String?                  @db.VarChar(150)
  is_published     Boolean                  @default(false)
  published_at     DateTime?                @db.Timestamptz(6)
  view_count       Int                      @default(0)
  meta_title       String?                  @db.VarChar(200)
  meta_description String?                  @db.VarChar(320)
  search_vector    Unsupported("tsvector")?
  created_at       DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at       DateTime                 @default(now()) @db.Timestamptz(6)
  blog_comments    blog_comments[]
  blog_post_tags   blog_post_tags[]
  users            users?                   @relation(fields: [author_id], references: [id], onUpdate: NoAction)
  blog_categories  blog_categories?         @relation(fields: [category_id], references: [id], onUpdate: NoAction)

  @@index([is_published, published_at(sort: Desc)], map: "idx_blog_published")
  @@index([search_vector], map: "idx_blog_search", type: Gin)
}

model brands {
  id          BigInt     @id @default(autoincrement())
  name        String     @db.VarChar(120)
  slug        String     @unique @db.VarChar(150)
  logo_url    String?
  country     String?    @db.VarChar(80)
  description String?
  is_active   Boolean    @default(true)
  products    products[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bundle_items {
  bundle_id        BigInt
  variant_id       BigInt
  quantity         Int              @default(1)
  bundles          bundles          @relation(fields: [bundle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants product_variants @relation(fields: [variant_id], references: [id], onUpdate: NoAction)

  @@id([bundle_id, variant_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bundles {
  id           BigInt         @id @default(autoincrement())
  name         String         @db.VarChar(200)
  slug         String         @unique @db.VarChar(240)
  description  String?
  image_url    String?
  price        Decimal        @db.Decimal(14, 0)
  starts_at    DateTime?      @db.Timestamptz(6)
  ends_at      DateTime?      @db.Timestamptz(6)
  is_active    Boolean        @default(true)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  updated_at   DateTime       @default(now()) @db.Timestamptz(6)
  bundle_items bundle_items[]
  cart_items   cart_items[]
  order_items  order_items[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cart_items {
  id               BigInt            @id @default(autoincrement())
  cart_id          BigInt
  variant_id       BigInt?
  bundle_id        BigInt?
  quantity         Int               @default(1)
  added_at         DateTime          @default(now()) @db.Timestamptz(6)
  bundles          bundles?          @relation(fields: [bundle_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  carts            carts             @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model carts {
  id            BigInt       @id @default(autoincrement())
  user_id       BigInt?
  session_token String?      @db.VarChar(80)
  coupon_id     BigInt?
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  updated_at    DateTime     @default(now()) @db.Timestamptz(6)
  expires_at    DateTime?    @db.Timestamptz(6)
  cart_items    cart_items[]
  coupons       coupons?     @relation(fields: [coupon_id], references: [id], onUpdate: NoAction)
  users         users?       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model categories {
  id                  BigInt                @id @default(autoincrement())
  parent_id           BigInt?
  name                String                @db.VarChar(120)
  slug                String                @unique @db.VarChar(150)
  description         String?
  image_url           String?
  sort_order          Int                   @default(0)
  is_active           Boolean               @default(true)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime              @default(now()) @db.Timestamptz(6)
  categories          categories?           @relation("categoriesTocategories", fields: [parent_id], references: [id], onUpdate: NoAction)
  other_categories    categories[]          @relation("categoriesTocategories")
  products            products[]
  quiz_option_effects quiz_option_effects[]

  @@index([parent_id], map: "idx_categories_parent")
}

model certifications {
  id                     BigInt                   @id @default(autoincrement())
  code                   String                   @unique @db.VarChar(40)
  name                   String                   @db.VarChar(150)
  issuer                 String?                  @db.VarChar(150)
  description            String?
  logo_url               String?
  product_certifications product_certifications[]
}

model challenge_checkins {
  id                BigInt          @id @default(autoincrement())
  user_challenge_id BigInt
  checkin_date      DateTime        @default(dbgenerated("CURRENT_DATE")) @db.Date
  note              String?
  user_challenges   user_challenges @relation(fields: [user_challenge_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_challenge_id, checkin_date])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model challenges {
  id              BigInt            @id @default(autoincrement())
  name            String            @db.VarChar(150)
  description     String?
  duration_days   Int
  points_reward   Int               @default(0)
  badge_id        BigInt?
  is_active       Boolean           @default(true)
  badges          badges?           @relation(fields: [badge_id], references: [id], onUpdate: NoAction)
  user_challenges user_challenges[]
}

model chat_messages {
  id                      BigInt        @id @default(autoincrement())
  session_id              BigInt
  role                    chat_role
  content                 String
  recommended_product_ids BigInt[]
  tokens_used             Int?
  created_at              DateTime      @default(now()) @db.Timestamptz(6)
  chat_sessions           chat_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_id, created_at], map: "idx_chat_messages_session")
}

model chat_sessions {
  id            BigInt          @id @default(autoincrement())
  user_id       BigInt?
  session_token String?         @db.VarChar(80)
  title         String?         @db.VarChar(200)
  created_at    DateTime        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime        @default(now()) @db.Timestamptz(6)
  chat_messages chat_messages[]
  users         users?          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_chat_sessions_user")
}

model contact_messages {
  id          BigInt   @id @default(autoincrement())
  user_id     BigInt?
  name        String   @db.VarChar(150)
  email       String   @db.Citext
  subject     String?  @db.VarChar(200)
  message     String
  is_resolved Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  users       users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model coupon_usages {
  id              BigInt   @id @default(autoincrement())
  coupon_id       BigInt
  user_id         BigInt?
  order_id        BigInt
  discount_amount Decimal  @db.Decimal(14, 0)
  used_at         DateTime @default(now()) @db.Timestamptz(6)
  coupons         coupons  @relation(fields: [coupon_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders          orders   @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users           users?   @relation(fields: [user_id], references: [id], onUpdate: NoAction)

  @@unique([coupon_id, order_id])
  @@index([coupon_id, user_id], map: "idx_coupon_usage_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model coupons {
  id                   BigInt            @id @default(autoincrement())
  code                 String            @unique @db.Citext
  description          String?
  discount_type        discount_type
  discount_value       Decimal           @default(0) @db.Decimal(12, 2)
  max_discount_amount  Decimal?          @db.Decimal(14, 0)
  min_order_amount     Decimal           @default(0) @db.Decimal(14, 0)
  usage_limit          Int?
  usage_limit_per_user Int               @default(1)
  used_count           Int               @default(0)
  first_order_only     Boolean           @default(false)
  min_tier_id          BigInt?
  starts_at            DateTime          @default(now()) @db.Timestamptz(6)
  ends_at              DateTime?         @db.Timestamptz(6)
  is_active            Boolean           @default(true)
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  updated_at           DateTime          @default(now()) @db.Timestamptz(6)
  carts                carts[]
  coupon_usages        coupon_usages[]
  membership_tiers     membership_tiers? @relation(fields: [min_tier_id], references: [id], onUpdate: NoAction)
  orders               orders[]
  referrals            referrals[]
}

model diets {
  id                  BigInt                @id @default(autoincrement())
  code                String                @unique @db.VarChar(40)
  name_vi             String                @db.VarChar(100)
  name_en             String?               @db.VarChar(100)
  description         String?
  icon_url            String?
  product_diets       product_diets[]
  quiz_option_effects quiz_option_effects[]
  recipe_diets        recipe_diets[]
  user_diets          user_diets[]
}

model farms {
  id              BigInt            @id @default(autoincrement())
  name            String            @db.VarChar(200)
  owner_name      String?           @db.VarChar(150)
  province        String?           @db.VarChar(100)
  address         String?
  description     String?
  image_url       String?
  latitude        Decimal?          @db.Decimal(9, 6)
  longitude       Decimal?          @db.Decimal(9, 6)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  product_batches product_batches[]
  products        products[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model flash_sale_items {
  id               BigInt           @id @default(autoincrement())
  flash_sale_id    BigInt
  variant_id       BigInt
  sale_price       Decimal          @db.Decimal(14, 0)
  quantity_limit   Int
  sold_count       Int              @default(0)
  flash_sales      flash_sales      @relation(fields: [flash_sale_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product_variants product_variants @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([flash_sale_id, variant_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model flash_sales {
  id               BigInt             @id @default(autoincrement())
  name             String             @db.VarChar(200)
  starts_at        DateTime           @db.Timestamptz(6)
  ends_at          DateTime           @db.Timestamptz(6)
  is_active        Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  flash_sale_items flash_sale_items[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model food_diary {
  id               BigInt    @id @default(autoincrement())
  user_id          BigInt
  logged_on        DateTime  @default(dbgenerated("CURRENT_DATE")) @db.Date
  meal_type        meal_type
  product_id       BigInt?
  recipe_id        BigInt?
  custom_food_name String?   @db.VarChar(200)
  quantity_g       Decimal   @default(100) @db.Decimal(8, 1)
  calories_kcal    Decimal   @default(0) @db.Decimal(7, 1)
  protein_g        Decimal   @default(0) @db.Decimal(6, 1)
  carbohydrate_g   Decimal   @default(0) @db.Decimal(6, 1)
  fat_g            Decimal   @default(0) @db.Decimal(6, 1)
  note             String?
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  products         products? @relation(fields: [product_id], references: [id], onUpdate: NoAction)
  recipes          recipes?  @relation(fields: [recipe_id], references: [id], onUpdate: NoAction)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, logged_on], map: "idx_food_diary_user_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model health_profiles {
  user_id              BigInt         @id
  height_cm            Decimal        @db.Decimal(5, 1)
  weight_kg            Decimal        @db.Decimal(5, 1)
  target_weight_kg     Decimal?       @db.Decimal(5, 1)
  activity_level       activity_level @default(light)
  goal                 goal_type      @default(maintain)
  auto_calculate       Boolean        @default(true)
  bmi                  Decimal?       @db.Decimal(4, 1)
  bmr                  Decimal?       @db.Decimal(7, 0)
  tdee                 Decimal?       @db.Decimal(7, 0)
  daily_calorie_target Decimal?       @db.Decimal(7, 0)
  daily_protein_g      Decimal?       @db.Decimal(6, 1)
  daily_carb_g         Decimal?       @db.Decimal(6, 1)
  daily_fat_g          Decimal?       @db.Decimal(6, 1)
  daily_water_ml       Int            @default(2000)
  medical_note         String?
  updated_at           DateTime       @default(now()) @db.Timestamptz(6)
  users                users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ingredients {
  id                  BigInt                @id @default(autoincrement())
  name                String                @unique @db.VarChar(150)
  name_en             String?               @db.VarChar(150)
  is_additive         Boolean               @default(false)
  description         String?
  product_ingredients product_ingredients[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory {
  id                BigInt          @id @default(autoincrement())
  warehouse_id      BigInt
  batch_id          BigInt
  quantity_on_hand  Int             @default(0)
  quantity_reserved Int             @default(0)
  updated_at        DateTime        @default(now()) @db.Timestamptz(6)
  product_batches   product_batches @relation(fields: [batch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  warehouses        warehouses      @relation(fields: [warehouse_id], references: [id], onUpdate: NoAction)

  @@unique([warehouse_id, batch_id])
  @@index([batch_id], map: "idx_inventory_batch")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model loyalty_accounts {
  user_id          BigInt            @id
  points_balance   Int               @default(0)
  lifetime_points  Int               @default(0)
  tier_id          BigInt?
  updated_at       DateTime          @default(now()) @db.Timestamptz(6)
  membership_tiers membership_tiers? @relation(fields: [tier_id], references: [id], onUpdate: NoAction)
  users            users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model loyalty_transactions {
  id          BigInt           @id @default(autoincrement())
  user_id     BigInt
  txn_type    loyalty_txn_type
  points      Int
  order_id    BigInt?
  description String?          @db.VarChar(255)
  expires_at  DateTime?        @db.Timestamptz(6)
  created_at  DateTime         @default(now()) @db.Timestamptz(6)
  orders      orders?          @relation(fields: [order_id], references: [id], onUpdate: NoAction)
  users       users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "idx_loyalty_txn_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model meal_plan_items {
  id           BigInt     @id @default(autoincrement())
  meal_plan_id BigInt
  day_number   Int
  meal_type    meal_type
  product_id   BigInt?
  recipe_id    BigInt?
  quantity     Decimal    @default(1) @db.Decimal(6, 2)
  note         String?    @db.VarChar(255)
  meal_plans   meal_plans @relation(fields: [meal_plan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products     products?  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recipes      recipes?   @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([meal_plan_id, day_number], map: "idx_meal_items_plan")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model meal_plans {
  id              BigInt            @id @default(autoincrement())
  owner_user_id   BigInt?
  name            String            @db.VarChar(200)
  slug            String?           @unique @db.VarChar(240)
  description     String?
  goal            goal_type?
  duration_days   Int
  target_calories Decimal?          @db.Decimal(7, 0)
  image_url       String?
  is_template     Boolean           @default(true)
  is_published    Boolean           @default(false)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @default(now()) @db.Timestamptz(6)
  meal_plan_items meal_plan_items[]
  users           users?            @relation(fields: [owner_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_meal_plans user_meal_plans[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model membership_tiers {
  id                BigInt             @id @default(autoincrement())
  code              String             @unique @db.VarChar(20)
  name              String             @db.VarChar(60)
  min_points        Int                @unique
  discount_percent  Decimal            @default(0) @db.Decimal(4, 1)
  points_multiplier Decimal            @default(1) @db.Decimal(3, 1)
  benefits          Json               @default("{}")
  coupons           coupons[]
  loyalty_accounts  loyalty_accounts[]
}

model notification_preferences {
  user_id          BigInt   @id
  email_order      Boolean  @default(true)
  email_promo      Boolean  @default(true)
  push_enabled     Boolean  @default(true)
  zalo_enabled     Boolean  @default(false)
  reorder_reminder Boolean  @default(true)
  updated_at       DateTime @default(now()) @db.Timestamptz(6)
  users            users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model notifications {
  id         BigInt            @id @default(autoincrement())
  user_id    BigInt
  type       notification_type
  title      String            @db.VarChar(200)
  body       String?
  data       Json              @default("{}")
  is_read    Boolean           @default(false)
  read_at    DateTime?         @db.Timestamptz(6)
  created_at DateTime          @default(now()) @db.Timestamptz(6)
  users      users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, is_read, created_at(sort: Desc)], map: "idx_notifications_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model nutrition_facts {
