# ---------------------------------------------------------------
# NUTRIO backend – copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------
PORT=5001
NODE_ENV=development

# Local embedded PostgreSQL (started by `npm run db:start`).
# The password below is only for the local dev database – change it if you like.
DATABASE_URL="postgresql://postgres:nutrio_local_dev@localhost:5433/nutrio_db?schema=public"

# JWT – use a long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET="change_me_to_a_long_random_string"
JWT_EXPIRES_IN="7d"

# Frontend URL (used for CORS, email links and payment return URLs)
FRONTEND_URL="http://localhost:3000"
# Public URL of this API (used to build absolute upload URLs)
PUBLIC_API_URL="http://localhost:5001"

# ---- Optional: SMTP (order confirmation / password reset emails) ----
# Leave empty to disable sending. Emails are then logged to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NUTRIO <no-reply@nutrio.vn>"

# ---- Optional: VNPay sandbox (https://sandbox.vnpayment.vn) ----
# Leave empty to hide VNPay at checkout.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"

# ---- Optional: MoMo sandbox (https://developers.momo.vn) ----
# Leave empty to hide MoMo at checkout.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"

# ---- Bank transfer information shown to customers ----
BANK_NAME="Vietcombank"
BANK_BIN="970436"
BANK_ACCOUNT_NO="0000000000"
BANK_ACCOUNT_NAME="CONG TY NUTRIO FOOD"
